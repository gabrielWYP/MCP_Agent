        <mxCell id="sel" value="&lt;div style=&quot;font-size:12px;font-weight:600;color:#8E2F2F;&quot;&gt;select_by_strides( teacher [4, 8, 16, 32]&amp;nbsp; →&amp;nbsp; student [8, 16, 32] )&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#5A6C7D;margin-top:4px;&quot;&gt;levels are matched &lt;b&gt;by stride&lt;/b&gt;, never by list position — a positional zip would silently misalign the pyramid&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDF4F4;strokeColor=#B03A2E;strokeWidth=2;" vertex="1" parent="1">
